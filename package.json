{
  "name": "@kujolang/workcell-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server/main.js",
    "start": "node src/server/main.js",
    "test": "node --test tests/*.test.js",
    "lint": "node --check src/server/main.js && node --check src/server/studio.js && node --check webmcp/register-tools.js",
    "format": "node scripts/check-format.js",
    "smoke": "bash scripts/smoke.sh",
    "eval": "bash scripts/eval-studio.sh",
    "shipcheck": "bash scripts/shipcheck.sh",
    "release": "bash scripts/release-gate.sh"
  },
  "engines": {"node": ">=20"},
  "license": "MIT"
}
